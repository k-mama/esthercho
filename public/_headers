# HTML and route responses should be revalidated so mobile browsers do not keep a stale 404 shell.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Next.js fingerprinted assets are safe to cache for a long time.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Media and brand assets can be cached, but not forever.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
