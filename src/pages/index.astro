---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="foundation" aria-labelledby="site-title">
    <h1 id="site-title">ESTHER CHO</h1>
    <p class="subtitle">A House of Stories</p>
    <p class="status">Foundation build in progress.</p>
  </section>
</BaseLayout>

<style>
  .foundation {
    min-height: 100vh;
    display: grid;
    place-content: center;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-family: var(--font-story);
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .subtitle {
    margin: 1rem 0 0;
    color: var(--color-ink-soft);
    font-family: var(--font-story);
    font-size: clamp(1.25rem, 3vw, 2rem);
  }

  .status {
    margin: 4rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
</style>
